<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- rheon tck-addendum: DMN 1.6 DMN17-96 (DMN 1.7 beta 1); drop when the official TCK covers this -->
<definitions namespace="https://github.com/spearsandshields/rheon/tck-addendum/rheon-1701-trim-function"
             name="rheon-1701-trim-function"
             id="_rheon-1701-trim-function"
             xmlns="https://www.omg.org/spec/DMN/20240513/MODEL/"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>DMN 1.7 beta 1 built-in function trim(string) (DMN17-96), adopted early by rheon on a DMN 1.6 model</description>

    <decision name="decision001" id="_decision001">
        <variable name="decision001"/>
        <literalExpression>
            <text>trim(" abc ")</text>
        </literalExpression>
    </decision>

    <decision name="decision002" id="_decision002">
        <variable name="decision002"/>
        <literalExpression>
            <text>trim("x ")</text>
        </literalExpression>
    </decision>

    <decision name="decision003" id="_decision003">
        <variable name="decision003"/>
        <literalExpression>
            <text>trim("")</text>
        </literalExpression>
    </decision>

    <decision name="decision004" id="_decision004">
        <variable name="decision004"/>
        <literalExpression>
            <text>trim(null)</text>
        </literalExpression>
    </decision>

    <decision name="decision005" id="_decision005">
        <variable name="decision005"/>
        <literalExpression>
            <text>trim("abc")</text>
        </literalExpression>
    </decision>

    <decision name="decision006" id="_decision006">
        <variable name="decision006"/>
        <literalExpression>
            <text>trim("  a  b  ")</text>
        </literalExpression>
    </decision>

    <decision name="decision007" id="_decision007">
        <variable name="decision007"/>
        <literalExpression>
            <text>trim("   ")</text>
        </literalExpression>
    </decision>

    <decision name="decision008" id="_decision008">
        <variable name="decision008"/>
        <literalExpression>
            <text>trim("\t\n abc \r\n")</text>
        </literalExpression>
    </decision>

    <decision name="decision009" id="_decision009">
        <variable name="decision009"/>
        <literalExpression>
            <text>trim("\u00A0\u2000\u200Babc\u3000\uFEFF")</text>
        </literalExpression>
    </decision>

    <decision name="decision010" id="_decision010">
        <variable name="decision010"/>
        <literalExpression>
            <text>string length(trim("\u200Cabc"))</text>
        </literalExpression>
    </decision>

    <decision name="decision011" id="_decision011">
        <variable name="decision011"/>
        <literalExpression>
            <text>trim(string: " abc ")</text>
        </literalExpression>
    </decision>

    <decision name="decision012" id="_decision012">
        <variable name="decision012"/>
        <literalExpression>
            <text>trim(123)</text>
        </literalExpression>
    </decision>

    <decision name="decision013" id="_decision013">
        <variable name="decision013"/>
        <literalExpression>
            <text>trim()</text>
        </literalExpression>
    </decision>

    <decision name="decision014" id="_decision014">
        <variable name="decision014"/>
        <literalExpression>
            <text>trim("\u0085\u1680\u180E\u2028\u2029\u202F\u205F\u000B\u000Cabc\u2001\u200A")</text>
        </literalExpression>
    </decision>

    <decision name="decision015" id="_decision015">
        <variable name="decision015"/>
        <literalExpression>
            <text>string length(trim("\u0001abc\u001F"))</text>
        </literalExpression>
    </decision>

</definitions>
