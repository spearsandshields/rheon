<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- rheon tck-addendum: DMN 1.6 DMN16-91 (B-FEEL), DMN16-71 (string coercion, merged into B-FEEL), DMN16-208 (single-parameter number()); drop when the official TCK covers this -->
<definitions namespace="https://github.com/spearsandshields/rheon/tck-addendum/rheon-1607-b-feel-functions"
             name="rheon-1607-b-feel-functions"
