             expressionLanguage="https://www.omg.org/spec/DMN/20240513/B-FEEL/"
             xmlns="https://www.omg.org/spec/DMN/20240513/MODEL/">
    <description>B-FEEL (DMN 1.6 chapter 11): built-in functions return type-specific defaults instead of null (boolean, number, string, temporal, duration, collection, range)</description>

    <decision name="decision001" id="_decision001">
        <variable name="decision001"/>
        <literalExpression>
            <text>matches("bad pattern", "[0-9")</text>
        </literalExpression>
    </decision>

    <decision name="decision002" id="_decision002">
