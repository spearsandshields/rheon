        </literalExpression>
    </decision>

    <decision name="decision058" id="_decision058">
        <variable name="decision058"/>
        <literalExpression>
            <text>insert before([1, 2], "x", 3)</text>
        </literalExpression>
    </decision>

    <decision name="decision059" id="_decision059">
        <variable name="decision059"/>
        <literalExpression>
            <text>range("x") = range("(0..0)")</text>
        </literalExpression>
    </decision>

    <decision name="decision060" id="_decision060">
        <variable name="decision060"/>
        <literalExpression>
            <text>range(null) = range("(0..0)")</text>
        </literalExpression>
    </decision>

    <decision name="decision061" id="_decision061">
