        <literalExpression>
            <text>range("x").start</text>
        </literalExpression>
    </decision>

    <decision name="decision062" id="_decision062">
        <variable name="decision062"/>
        <literalExpression>
            <text>range("x").start included</text>
        </literalExpression>
    </decision>

    <decision name="decision063" id="_decision063">
        <variable name="decision063"/>
        <literalExpression>
            <text>0 in range("x")</text>
        </literalExpression>
    </decision>

    <decision name="decision064" id="_decision064">
        <variable name="decision064"/>
        <decisionTable hitPolicy="COLLECT" aggregation="SUM">
            <input id="_decision064_i1">
                <inputExpression>
                    <text>1</text>
                </inputExpression>
            </input>
            <output id="_decision064_o1"/>
            <rule id="_decision064_r1">
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>1</text></outputEntry>
            </rule>
            <rule id="_decision064_r2">
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>null</text></outputEntry>
            </rule>
            <rule id="_decision064_r3">
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>"x"</text></outputEntry>
            </rule>
            <rule id="_decision064_r4">
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>3</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>

    <decision name="decision065" id="_decision065">
        <variable name="decision065"/>
        <literalExpression>
