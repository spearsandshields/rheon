<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- rheon tck-addendum: DMN 1.6 DMN17-100 (DMN 1.7 beta 1); drop when the official TCK covers this -->
<definitions namespace="https://github.com/spearsandshields/rheon/tck-addendum/rheon-1703-insert-after-function"
             name="rheon-1703-insert-after-function"
             id="_rheon-1703-insert-after-function"
             xmlns="https://www.omg.org/spec/DMN/20240513/MODEL/"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>DMN 1.7 beta 1 built-in function insert after(list, position, newItem) (DMN17-100), adopted early by rheon on a DMN 1.6 model</description>

    <decision name="decision001" id="_decision001">
        <variable name="decision001"/>
        <literalExpression>
            <text>insert after([1,3],1,2)</text>
        </literalExpression>
    </decision>

    <decision name="decision002" id="_decision002">
        <variable name="decision002"/>
        <literalExpression>
            <text>insert after([1,3], null, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision003" id="_decision003">
        <variable name="decision003"/>
        <literalExpression>
            <text>insert after([1,3], 1, null)</text>
        </literalExpression>
    </decision>

    <decision name="decision004" id="_decision004">
        <variable name="decision004"/>
        <literalExpression>
            <text>insert after([1,3], 1, "2")</text>
        </literalExpression>
    </decision>

    <decision name="decision005" id="_decision005">
        <variable name="decision005"/>
        <literalExpression>
            <text>insert after([1,3], 2, 4)</text>
        </literalExpression>
    </decision>

    <decision name="decision006" id="_decision006">
        <variable name="decision006"/>
        <literalExpression>
            <text>insert after([1,3], -1, 4)</text>
        </literalExpression>
    </decision>

    <decision name="decision007" id="_decision007">
        <variable name="decision007"/>
        <literalExpression>
            <text>insert after([1,3], -2, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision008" id="_decision008">
        <variable name="decision008"/>
        <literalExpression>
            <text>insert after([1,3], 0, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision009" id="_decision009">
        <variable name="decision009"/>
        <literalExpression>
            <text>insert after([1,3], 3, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision010" id="_decision010">
        <variable name="decision010"/>
        <literalExpression>
            <text>insert after([1,3], -3, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision011" id="_decision011">
        <variable name="decision011"/>
        <literalExpression>
            <text>insert after([], 1, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision012" id="_decision012">
        <variable name="decision012"/>
        <literalExpression>
            <text>insert after(null, 1, 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision013" id="_decision013">
        <variable name="decision013"/>
        <literalExpression>
            <text>insert after([1,3], "1", 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision014" id="_decision014">
        <variable name="decision014"/>
        <literalExpression>
            <text>insert after([1,3], 1, [2])</text>
        </literalExpression>
    </decision>

    <decision name="decision015" id="_decision015">
        <variable name="decision015"/>
        <literalExpression>
            <text>insert after(list: [1,3], position: 1, newItem: 2)</text>
        </literalExpression>
    </decision>

    <decision name="decision016" id="_decision016">
        <variable name="decision016"/>
        <literalExpression>
            <text>insert after([1,3], 1)</text>
        </literalExpression>
    </decision>

    <decision name="decision017" id="_decision017">
        <variable name="decision017"/>
        <literalExpression>
            <text>insert after([1,2,3,4], 2, 9)</text>
        </literalExpression>
    </decision>

    <decision name="decision018" id="_decision018">
        <variable name="decision018"/>
        <literalExpression>
            <text>insert after([1,2,3,4], -2, 9)</text>
        </literalExpression>
    </decision>

    <decision name="decision019" id="_decision019">
        <variable name="decision019"/>
        <literalExpression>
            <text>insert after(list: [1,3], newItem: 2)</text>
        </literalExpression>
    </decision>

</definitions>
