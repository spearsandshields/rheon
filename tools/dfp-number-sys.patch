-#[cfg(target_arch = "x86_64")]
-const ARCHITECTURE: &str = "ix86";
-
-#[cfg(target_arch = "aarch64")]
-const ARCHITECTURE: &str = "ix86";
-
-#[cfg(target_os = "linux")]
-const OPERATING_SYSTEM: &str = "linux";
-#[cfg(target_os = "windows")]
-const OPERATING_SYSTEM: &str = "win64";
-#[cfg(target_os = "macos")]
-const OPERATING_SYSTEM: &str = "darwin";
 
 /// Main entrypoint of the building script.
 ///
@@ -36,8 +24,16 @@ const OPERATING_SYSTEM: &str = "darwin";
 /// Only files required by this crate are used and stored in crates.io.
 ///
 fn main() {
+  // Pick the C defines from the TARGET, not the host: inside a build script `cfg!(target_os)`
+  // describes the machine running the build, which is wrong when cross-compiling (e.g. to wasm32).
+  let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap();
+  let os = std::env::var("CARGO_CFG_TARGET_OS").unwrap();
+  #[allow(non_snake_case)] let ARCHITECTURE = "ix86";
+  #[allow(non_snake_case)] let OPERATING_SYSTEM = match os.as_str() { "windows" => "win64", "macos" => "darwin", _ => "linux" };
   let output_dir = PathBuf::from(std::env::var("OUT_DIR").unwrap());
-  cc::Build::new()
+  let mut b = cc::Build::new();
+  if arch == "wasm32" { b.define("_WASI_EMULATED_SIGNAL", None); }
+  b
     .define(ARCHITECTURE, None)
     .define(OPERATING_SYSTEM, None)
     .define("DECIMAL_CALL_BY_REFERENCE", DECIMAL_CALL_BY_REFERENCE)
