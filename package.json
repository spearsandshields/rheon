{
  "name": "rheon",
  "private": true,
  "version": "0.5.0",
  "description": "rheon: the FEEL engine as WebAssembly (exact 34-digit decimals), its TypeScript runtime and the browser playground",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "build:wasm": "./scripts/build-wasm.sh",
    "build:runtime": "npm run build -w @rheon/feel-runtime",
    "notices": "node scripts/third-party-notices.mjs",
    "build:playground": "npm run notices && npm run build -w @rheon/playground",
    "build": "npm run build:wasm && npm run build:runtime && npm run build:playground",
    "dev": "npm run build:runtime && npm run dev -w @rheon/playground --",
    "preview": "npm run preview -w @rheon/playground --",
    "test": "npm run test:rust && npm run test:rust:wasm && npm run test:runtime",
    "test:rust": "cargo test -p rheon-feel-wasm",
    "test:rust:wasm": "bash -c 'source ./scripts/env.sh && cargo test -p rheon-feel-wasm --target wasm32-wasip1'",
    "test:runtime": "npm test -w @rheon/feel-runtime",
    "test:identity": "node --test tools/identity/test.mjs",
    "identity": "bash tools/identity/fetch-baseline.sh && bash tools/identity/run.sh .tools/baseline/feel.wasm dist/feel.wasm",
    "identity:large": "bash tools/identity/fetch-baseline.sh && bash tools/identity/run.sh .tools/baseline/feel.wasm dist/feel.wasm --large",
    "smoke": "node scripts/smoke.mjs",
    "stack": "node scripts/stack-headroom.mjs"
  },
  "engines": {
    "node": ">=21"
  }
}
