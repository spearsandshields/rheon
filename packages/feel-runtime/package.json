{
  "name": "@rheon/feel-runtime",
  "version": "0.4.0",
  "description": "JS/TS runtime for the rheon FEEL engine compiled to WebAssembly (wasm32-wasip1, exact decimal128 numbers)",
  "keywords": [
    "feel",
    "dmn",
    "decision",
    "expression",
    "wasm",
    "webassembly",
    "wasi",
    "decimal128",
    "rheon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearsandshields/rheon.git",
    "directory": "packages/feel-runtime"
  },
  "homepage": "https://spearsandshields.github.io/rheon/",
  "bugs": "https://github.com/spearsandshields/rheon/issues",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./wasi": {
      "types": "./dist/wasi.d.ts",
      "default": "./dist/wasi.js"
    },
    "./package.json": "./package.json",
    "./feel.wasm": "./feel.wasm"
  },
  "files": [
    "dist",
    "src",
    "feel.wasm",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-timeout=120000 test/*.test.mjs",
    "prepack": "npm run build && node scripts/prepack.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
